# ─────────────────────────────────────────────────────────────────────────────
# Vakta configuration. Copy this file to ".env" and fill in what you have.
# Anything left empty simply stays "not configured" and Vakta uses a safe
# local stand-in (e.g. simulated SMS, test phone numbers).
# ─────────────────────────────────────────────────────────────────────────────

# Basics ───────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://vakta:vakta@localhost:5432/vakta
# Public address of this server. Twilio must be able to reach it (https in production).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vakta
# Long random strings. Generate with:  openssl rand -base64 48
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Claude (the AI) ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
VOICE_MODEL=claude-opus-5-5
VOICE_EFFORT=low
SUMMARY_MODEL=claude-opus-5-5

# Twilio (phone numbers, calls, SMS) — create the account in region IE1 ──────
# TELEPHONY_PROVIDER=mock forces test numbers even if Twilio keys exist.
TELEPHONY_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_REGION=ie1
TWILIO_EDGE=dublin
# Voice settings used by Twilio ConversationRelay
TTS_PROVIDER=Google
TTS_VOICE_NB=nb-NO-Chirp3-HD-Aoede
TTS_VOICE_EN=en-GB-Chirp3-HD-Aoede
STT_PROVIDER=Deepgram
STT_MODEL_NB=
SMS_DEFAULT_SENDER=Vakta

# Stripe (subscriptions) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Calendar sync ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: better travel-time estimates between jobs
GOOGLE_MAPS_API_KEY=

# Email (invitations, password reset). Example: smtps://user:pass@smtp-relay.brevo.com:465
SMTP_URL=
EMAIL_FROM=Vakta <no-reply@example.no>
