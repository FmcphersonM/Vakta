{
  "name": "vakta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src/app --ignore ./.next server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "db:local": "bash scripts/local-postgres.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "cron": "tsx scripts/cron.ts",
    "twilio:setup": "tsx scripts/twilio-setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.73.0",
    "luxon": "3.7.2",
    "next": "16.4.6",
    "nodemailer": "10.6.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.1.0",
    "tsx": "4.23.15",
    "twilio": "6.3.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
